<Window x:Class="CameraYolo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CameraYolo — 摄像头实时检测"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#0F1419">
  <Window.Resources>
    <!-- 深色下拉项样式 -->
    <Style x:Key="DarkComboItemStyle" TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#1A2332"/>
      <Setter Property="Foreground" Value="#E7ECF3"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="1"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2F81F7"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2F81F7"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 深色 ComboBox 完整模板 -->
    <Style x:Key="DarkComboStyle" TargetType="ComboBox">
      <Setter Property="Background" Value="#1A2332"/>
      <Setter Property="Foreground" Value="#E7ECF3"/>
      <Setter Property="BorderBrush" Value="#30363D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="24"/>
                      </Grid.ColumnDefinitions>
                      <Border x:Name="Bd" Grid.ColumnSpan="2"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="4" SnapsToDevicePixels="True"/>
                      <Path x:Name="Arrow" Grid.Column="1"
                            Data="M 0 0 L 5 5 L 10 0" Stroke="#E7ECF3" StrokeThickness="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    </Grid>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ContentSite"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                IsHitTestVisible="False"
                                Margin="8,4,28,4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
              <Popup x:Name="Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Slide">
                <Grid x:Name="DropDown"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      SnapsToDevicePixels="True">
                  <Border x:Name="DropDownBorder"
                          Background="#1A2332"
                          BorderBrush="#30363D"
                          BorderThickness="1"
                          CornerRadius="4"/>
                  <ScrollViewer Margin="4,4" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                CanContentScroll="True">
                    <StackPanel IsItemsHost="True"/>
                  </ScrollViewer>
                </Grid>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 深色复选框样式 -->
    <Style x:Key="DarkCheckStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E7ECF3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="12">
    <!-- Top toolbar -->
    <Border DockPanel.Dock="Top" Background="#1A2332" CornerRadius="8" Padding="12" Margin="0,0,0,10">
      <WrapPanel VerticalAlignment="Center">
        <!-- 摄像头选择 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="摄像头" Foreground="#9FB3C8" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="CameraCombo" Width="130" SelectedIndex="0"
                    Style="{StaticResource DarkComboStyle}"
                    ItemContainerStyle="{StaticResource DarkComboItemStyle}"/>
        </StackPanel>

        <!-- 检测模式 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="模式" Foreground="#9FB3C8" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="ModeCombo" Width="110" SelectedIndex="0"
                    Style="{StaticResource DarkComboStyle}"
                    ItemContainerStyle="{StaticResource DarkComboItemStyle}"
                    SelectionChanged="ModeCombo_Changed"/>
        </StackPanel>

        <!-- 启动 / 停止 -->
        <Button x:Name="StartBtn" Content="启动" Margin="0,0,6,0" Width="72" Height="30"
                Click="StartBtn_Click" Background="#2F81F7" Foreground="White" BorderThickness="0"/>
        <Button x:Name="StopBtn" Content="停止" Margin="0,0,12,0" Width="72" Height="30"
                Click="StopBtn_Click" Background="#30363D" Foreground="#E7ECF3" BorderThickness="0" IsEnabled="False"/>

        <!-- 实时检测 -->
        <CheckBox x:Name="DetectCheck" Content="实时检测" IsChecked="True" Margin="0,0,12,0"
                  Style="{StaticResource DarkCheckStyle}"
                  Checked="DetectCheck_Changed" Unchecked="DetectCheck_Changed"/>

        <!-- 表情识别（仅人脸识别模式可见） -->
        <CheckBox x:Name="EmotionCheck" Content="表情识别" IsChecked="False" Margin="0,0,12,0"
                  Style="{StaticResource DarkCheckStyle}"
                  Visibility="Collapsed"
                  Checked="EmotionCheck_Changed" Unchecked="EmotionCheck_Changed"/>

        <!-- 置信度 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="置信度" Foreground="#9FB3C8" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Slider x:Name="ConfSlider" Width="100" Minimum="0.05" Maximum="0.95" Value="0.45" TickFrequency="0.05"
                  ValueChanged="ConfSlider_ValueChanged"/>
          <TextBlock x:Name="ConfText" Text="0.45" Foreground="#E7ECF3" Width="36" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 加载模型 -->
        <Button x:Name="LoadModelBtn" Content="加载模型" Margin="0,0,6,0" Width="96" Height="30"
                Click="LoadModel_Click" Background="#238636" Foreground="White" BorderThickness="0"/>

        <!-- 推理设备 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="设备" Foreground="#9FB3C8" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="DeviceCombo" Width="130" SelectedIndex="0"
                    Style="{StaticResource DarkComboStyle}"
                    ItemContainerStyle="{StaticResource DarkComboItemStyle}"
                    SelectionChanged="DeviceCombo_Changed"/>
        </StackPanel>

        <!-- FPS -->
        <TextBlock x:Name="FpsText" Text="未启动" Foreground="#3FB950" VerticalAlignment="Center"
                   FontFamily="Consolas"/>
      </WrapPanel>
    </Border>

    <!-- Status -->
    <StatusBar DockPanel.Dock="Bottom" Background="#1A2332" Margin="0,10,0,0">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="就绪 — 请加载 YOLO 模型后启动摄像头" Foreground="#9FB3C8"/>
      </StatusBarItem>
    </StatusBar>

    <!-- Main content -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#000" CornerRadius="8" ClipToBounds="True">
        <Grid>
          <Image x:Name="PreviewImage" Stretch="Uniform"/>
          <TextBlock x:Name="PlaceholderText"
                     Text="摄像头预览区&#x0a;&#x0a;1. 点击「加载模型」选择 ONNX / Darknet&#x0a;2. 选择摄像头并启动&#x0a;3. 可用训练脚本自训模型"
                     Foreground="#5A6A7A" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"
                     HorizontalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#1A2332" CornerRadius="8" Padding="12" Margin="10,0,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="检测结果" Foreground="#E7ECF3" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock DockPanel.Dock="Top" x:Name="ModelInfoText" Text="模型：未加载" Foreground="#9FB3C8"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>
          <ListBox x:Name="ResultList" Background="#0F1419" Foreground="#E7ECF3" BorderThickness="0"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>