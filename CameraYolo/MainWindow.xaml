<Window x:Class="CameraYolo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CameraYolo — 摄像头实时 YOLO 检测"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#0F1419">
  <DockPanel Margin="12">
    <!-- Top toolbar -->
    <Border DockPanel.Dock="Top" Background="#1A2332" CornerRadius="8" Padding="12" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="摄像头" Foreground="#9FB3C8" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="CameraCombo" Width="160" SelectedIndex="0" Background="#0F1419" Foreground="#E7ECF3"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="StartBtn" Content="启动" Margin="10,0,0,0" Width="72" Height="30"
                Click="StartBtn_Click" Background="#2F81F7" Foreground="White" BorderThickness="0"/>
        <Button Grid.Column="2" x:Name="StopBtn" Content="停止" Margin="8,0,0,0" Width="72" Height="30"
                Click="StopBtn_Click" Background="#30363D" Foreground="#E7ECF3" BorderThickness="0" IsEnabled="False"/>
        <CheckBox Grid.Column="3" x:Name="DetectCheck" Content="实时检测" IsChecked="True" Margin="16,0,0,0"
                  Foreground="#E7ECF3" VerticalAlignment="Center" Checked="DetectCheck_Changed" Unchecked="DetectCheck_Changed"/>
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="置信度" Foreground="#9FB3C8" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Slider x:Name="ConfSlider" Width="110" Minimum="0.05" Maximum="0.95" Value="0.45" TickFrequency="0.05"
                  ValueChanged="ConfSlider_ValueChanged"/>
          <TextBlock x:Name="ConfText" Text="0.45" Foreground="#E7ECF3" Width="36" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="5" Content="加载模型" Margin="12,0,0,0" Width="96" Height="30"
                Click="LoadModel_Click" Background="#238636" Foreground="White" BorderThickness="0"/>
        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="设备" Foreground="#9FB3C8" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="DeviceCombo" Width="130" SelectedIndex="0" Background="#0F1419" Foreground="#E7ECF3"
                    SelectionChanged="DeviceCombo_Changed"/>
        </StackPanel>
        <TextBlock Grid.Column="7" x:Name="FpsText" Text="未启动" Foreground="#3FB950" VerticalAlignment="Center"
                   FontFamily="Consolas"/>
      </Grid>
    </Border>

    <!-- Status -->
    <StatusBar DockPanel.Dock="Bottom" Background="#1A2332" Margin="0,10,0,0">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="就绪 — 请加载 YOLO 模型后启动摄像头" Foreground="#9FB3C8"/>
      </StatusBarItem>
    </StatusBar>

    <!-- Main content -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#000" CornerRadius="8" ClipToBounds="True">
        <Grid>
          <Image x:Name="PreviewImage" Stretch="Uniform"/>
          <TextBlock x:Name="PlaceholderText"
                     Text="摄像头预览区&#x0a;&#x0a;1. 点击「加载模型」选择 ONNX / Darknet&#x0a;2. 选择摄像头并启动&#x0a;3. 可用训练脚本自训模型"
                     Foreground="#5A6A7A" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"
                     HorizontalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#1A2332" CornerRadius="8" Padding="12" Margin="10,0,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="检测结果" Foreground="#E7ECF3" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock DockPanel.Dock="Top" x:Name="ModelInfoText" Text="模型：未加载" Foreground="#9FB3C8"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>
          <ListBox x:Name="ResultList" Background="#0F1419" Foreground="#E7ECF3" BorderThickness="0"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
